    classDef generationLayer fill:#27AE60,stroke:#229954,stroke-width:3px,color:#FFFFFF,font-weight:bold
    classDef executionLayer fill:#F39C12,stroke:#E67E22,stroke-width:3px,color:#FFFFFF,font-weight:bold
    classDef featureNode fill:#E67E22,stroke:#D35400,stroke-width:2px,color:#FFFFFF,font-weight:bold
    
    %% スタイル適用
    class INPUT,OUTPUT inputOutput
    class VECTOR_DB,KNOWLEDGE_BASE,LEARNING_LOOP,CONTEXT_MEMORY aiLayer
    class ADAPTIVE_WORKFLOW,PARALLEL_PROCESSING,SENSOR_INTEGRATION,MOTION_OPTIMIZATION smartLayer
